{
  "info": {
    "_postman_id": "v2-oauth-smoke-test",
    "name": "Auth-Squared v2 OAuth Smoke Tests",
    "description": "Smoke tests for v2 OAuth (RS256 + JWKS + audience-scoped tokens).\n\nRun order:\n1. Discovery endpoints (no auth needed)\n2. Get owner token (v1 login for admin access)\n3. Mint test token (admin endpoint)\n4. Token exchange flow (requires manual auth code — see notes)\n5. Userinfo\n\nEnvironment: postman-v2-oauth-environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Discovery",
      "item": [
        {
          "name": "JWKS Endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has keys array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.keys).to.be.an('array');",
                  "  pm.expect(body.keys.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('Key has correct fields', () => {",
                  "  const key = pm.response.json().keys[0];",
                  "  pm.expect(key.kty).to.equal('RSA');",
                  "  pm.expect(key.use).to.equal('sig');",
                  "  pm.expect(key.alg).to.equal('RS256');",
                  "  pm.expect(key.kid).to.be.a('string');",
                  "  pm.expect(key.n).to.be.a('string');",
                  "  pm.expect(key.e).to.equal('AQAB');",
                  "});",
                  "pm.test('Cache-Control header set', () => {",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('max-age=3600');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/.well-known/jwks.json",
              "host": ["{{base_url}}"],
              "path": [".well-known", "jwks.json"]
            }
          }
        },
        {
          "name": "OpenID Configuration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has required OIDC fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.issuer).to.be.a('string');",
                  "  pm.expect(body.authorization_endpoint).to.include('/v2/oauth/authorize');",
                  "  pm.expect(body.token_endpoint).to.include('/v2/oauth/token');",
                  "  pm.expect(body.userinfo_endpoint).to.include('/v2/oauth/userinfo');",
                  "  pm.expect(body.jwks_uri).to.include('/.well-known/jwks.json');",
                  "  pm.expect(body.id_token_signing_alg_values_supported).to.include('RS256');",
                  "  pm.expect(body.scopes_supported).to.include('openid');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/.well-known/openid-configuration",
              "host": ["{{base_url}}"],
              "path": [".well-known", "openid-configuration"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Get Owner Token (v1)",
      "item": [
        {
          "name": "Login as Owner (v1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.environment.set('owner_token', body.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin: Mint Test Token",
      "item": [
        {
          "name": "Mint RS256 Token (group-1-api)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has access_token and id_token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.access_token).to.be.a('string');",
                  "  pm.expect(body.data.id_token).to.be.a('string');",
                  "  pm.expect(body.data.token_type).to.equal('Bearer');",
                  "  pm.environment.set('access_token', body.data.access_token);",
                  "  pm.environment.set('id_token', body.data.id_token);",
                  "});",
                  "pm.test('Claims include correct audience', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.claims.aud).to.equal('group-1-api');",
                  "  pm.expect(body.data.claims.sub).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": 1,\n  \"audience\": \"{{audience}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/tenants/tcss460-sp26/mint-token",
              "host": ["{{base_url}}"],
              "path": ["admin", "tenants", "tcss460-sp26", "mint-token"]
            }
          }
        }
      ]
    },
    {
      "name": "4. v2 Token Exchange",
      "item": [
        {
          "name": "Authorize Page (GET — browser flow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — login page rendered', () => pm.response.to.have.status(200));",
                  "pm.test('Page contains login form', () => {",
                  "  pm.expect(pm.response.text()).to.include('Sign in');",
                  "  pm.expect(pm.response.text()).to.include('/v2/oauth/authorize');",
                  "  pm.expect(pm.response.text()).to.include('name=\"audience\"');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/oauth/authorize?client_id={{client_id}}&redirect_uri={{redirect_uri}}&response_type=code&state=test123&audience={{audience}}&scope=openid profile email",
              "host": ["{{base_url}}"],
              "path": ["v2", "oauth", "authorize"],
              "query": [
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "redirect_uri", "value": "{{redirect_uri}}" },
                { "key": "response_type", "value": "code" },
                { "key": "state", "value": "test123" },
                { "key": "audience", "value": "{{audience}}" },
                { "key": "scope", "value": "openid profile email" }
              ]
            }
          }
        },
        {
          "name": "Token Exchange (requires auth_code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.test('Has RS256 tokens', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "    pm.expect(body.token_type).to.equal('Bearer');",
                  "    pm.expect(body.expires_in).to.equal(3600);",
                  "    pm.expect(body.refresh_token).to.be.a('string');",
                  "    pm.environment.set('access_token', body.access_token);",
                  "    pm.environment.set('refresh_token', body.refresh_token);",
                  "    if (body.id_token) pm.environment.set('id_token', body.id_token);",
                  "  });",
                  "} else {",
                  "  pm.test('Token exchange failed (set auth_code first)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "authorization_code" },
                { "key": "code", "value": "{{auth_code}}" },
                { "key": "redirect_uri", "value": "{{redirect_uri}}" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v2/oauth/token",
              "host": ["{{base_url}}"],
              "path": ["v2", "oauth", "token"]
            }
          }
        },
        {
          "name": "Refresh Token Grant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.test('Has new tokens', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "    pm.expect(body.refresh_token).to.be.a('string');",
                  "    pm.environment.set('access_token', body.access_token);",
                  "    pm.environment.set('refresh_token', body.refresh_token);",
                  "  });",
                  "} else {",
                  "  pm.test('Refresh failed (run token exchange first)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "refresh_token" },
                { "key": "refresh_token", "value": "{{refresh_token}}" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v2/oauth/token",
              "host": ["{{base_url}}"],
              "path": ["v2", "oauth", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Userinfo",
      "item": [
        {
          "name": "GET /v2/oauth/userinfo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has user profile', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.sub).to.be.a('string');",
                  "  pm.expect(body.email).to.be.a('string');",
                  "  pm.expect(body.name).to.be.a('string');",
                  "  pm.expect(body.role).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/v2/oauth/userinfo",
              "host": ["{{base_url}}"],
              "path": ["v2", "oauth", "userinfo"]
            }
          }
        }
      ]
    },
    {
      "name": "6. v1 Regression (MUST NOT BREAK)",
      "item": [
        {
          "name": "v1 Login (direct API)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('v1 login still works', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "v1 OAuth Authorize Page",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — v1 login page still renders', () => pm.response.to.have.status(200));",
                  "pm.test('Page uses v1 form action (not v2)', () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.include('action=\"/oauth/authorize\"');",
                  "  pm.expect(text).to.not.include('action=\"/v2/');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/oauth/authorize?client_id={{client_id}}&redirect_uri={{redirect_uri}}&response_type=code&state=v1test",
              "host": ["{{base_url}}"],
              "path": ["v1", "oauth", "authorize"],
              "query": [
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "redirect_uri", "value": "{{redirect_uri}}" },
                { "key": "response_type", "value": "code" },
                { "key": "state", "value": "v1test" }
              ]
            }
          }
        },
        {
          "name": "v1 OAuth Token (invalid code — verifies endpoint responds)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('v1 token endpoint responds (400 for invalid code)', () => {",
                  "  pm.expect(pm.response.code).to.equal(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.equal('invalid_grant');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "authorization_code" },
                { "key": "code", "value": "invalid-code-for-testing" },
                { "key": "redirect_uri", "value": "{{redirect_uri}}" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/oauth/token",
              "host": ["{{base_url}}"],
              "path": ["v1", "oauth", "token"]
            }
          }
        }
      ]
    }
  ]
}
