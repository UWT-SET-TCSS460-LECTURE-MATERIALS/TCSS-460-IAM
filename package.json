{
    "name": "tcss-460-auth-squared",
    "version": "1.0.0",
    "description": "TCSS-460-auth-squared - Identity and Authentication/Authorization Service for TCSS 460",
    "main": "dist/app.js",
    "scripts": {
        "postinstall": "prisma generate",
        "build": "prisma generate && tsc -p . && tsc-alias -p tsconfig.json && cp -r src/views dist/views",
        "start": "node dist/index.js",
        "start:full": "npm run docker:up && npm run local",
        "start:docker": "docker compose up",
        "start:local": "prisma migrate deploy && npm run local",
        "local": "nodemon --exec ts-node -r tsconfig-paths/register -r dotenv/config src/index.ts",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:restart": "docker compose restart",
        "docker:delete": "docker compose down -v",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:seed": "ts-node prisma/seed.ts",
        "prisma:studio": "prisma studio",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "format:check": "prettier --check .",
        "format:write": "prettier --write ."
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "keywords": [
        "authentication",
        "authorization",
        "jwt",
        "identity"
    ],
    "author": "Charles Bryan",
    "repository": {
        "type": "git",
        "url": "https://github.com/cfb3/TCSS-460-auth-squared"
    },
    "engines": {
        "node": "22.14.0"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.3",
        "@types/nodemailer": "^6.4.14",
        "@types/pg": "^8.15.5",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/yamljs": "^0.2.34",
        "@typescript-eslint/eslint-plugin": "^8.41.0",
        "@typescript-eslint/parser": "^8.41.0",
        "dotenv": "^16.4.7",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^9.1.0",
        "jest": "^30.1.3",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "prisma": "^7.5.0",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "^7.5.0",
        "@types/cookie-parser": "^1.4.10",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "ejs": "^5.0.1",
        "express": "^5.1.0",
        "express-rate-limit": "^8.3.2",
        "express-validator": "^7.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^7.0.6",
        "pg": "^8.16.3",
        "swagger-ui-express": "^5.0.1",
        "twilio": "^5.9.0",
        "yamljs": "^0.3.0"
    }
}
