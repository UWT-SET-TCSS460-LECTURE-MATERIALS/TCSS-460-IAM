// Prisma Schema for Auth-Squared
// Matches existing database schema from data/init.sql

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Existing Tables (migrated from raw SQL)
// ============================================================

model Account {
  accountId     Int      @id @default(autoincrement()) @map("account_id")
  firstName     String   @map("firstname") @db.VarChar(255)
  lastName      String   @map("lastname") @db.VarChar(255)
  username      String   @unique @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  phone         String   @unique @db.VarChar(15)
  phoneVerified Boolean  @default(false) @map("phone_verified")
  accountRole   Int      @map("account_role")
  accountStatus String   @default("pending") @map("account_status") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  credential         AccountCredential?
  emailVerifications EmailVerification[]
  phoneVerifications PhoneVerification[]
  tenantMemberships  TenantMembership[]
  authorizationCodes OAuthAuthorizationCode[]
  refreshTokens      OAuthRefreshToken[]

  @@index([email], map: "idx_a2_account_email")
  @@index([phone], map: "idx_a2_account_phone")
  @@index([username], map: "idx_a2_account_username")
  @@index([accountStatus], map: "idx_a2_account_status")
  @@map("a2_account")
}

model AccountCredential {
  credentialId Int    @id @default(autoincrement()) @map("credential_id")
  accountId    Int    @unique @map("account_id")
  saltedHash   String @map("salted_hash") @db.VarChar(255)
  salt         String? @db.VarChar(255)

  account Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@map("a2_account_credential")
}

model EmailVerification {
  verificationId Int      @id @default(autoincrement()) @map("verification_id")
  accountId      Int      @map("account_id")
  email          String   @db.VarChar(255)
  verificationToken String @unique @map("verification_token") @db.VarChar(64)
  tokenExpires   DateTime @map("token_expires") @db.Timestamptz()
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId], map: "idx_a2_email_verification_account")
  @@index([verificationToken], map: "idx_a2_email_verification_token")
  @@index([tokenExpires], map: "idx_a2_email_verification_expires")
  @@map("a2_email_verification")
}

model PhoneVerification {
  verificationId   Int      @id @default(autoincrement()) @map("verification_id")
  accountId        Int      @map("account_id")
  phone            String   @db.VarChar(15)
  verificationCode String   @map("verification_code") @db.VarChar(6)
  codeExpires      DateTime @map("code_expires") @db.Timestamptz()
  attempts         Int      @default(0)
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId], map: "idx_a2_phone_verification_account")
  @@index([verificationCode], map: "idx_a2_phone_verification_code")
  @@index([codeExpires], map: "idx_a2_phone_verification_expires")
  @@map("a2_phone_verification")
}

// ============================================================
// OAuth2 + Multi-Tenancy Tables
// ============================================================

model Tenant {
  tenantId      String   @id @map("tenant_id") @db.VarChar(255)
  tenantName    String   @map("tenant_name") @db.VarChar(255)
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  autoProvision Boolean  @default(true) @map("auto_provision")
  autoActivate  Boolean  @default(false) @map("auto_activate")
  defaultRole   Int      @default(1) @map("default_role")
  brandingName  String?  @map("branding_name") @db.VarChar(255)
  brandingColor String?  @map("branding_color") @db.VarChar(7)
  createdAt     DateTime @default(now()) @map("created_at")

  memberships  TenantMembership[]
  clients      OAuthClient[]
  apiResources ApiResource[]

  @@map("a2_tenant")
}

model TenantMembership {
  membershipId Int      @id @default(autoincrement()) @map("membership_id")
  accountId    Int      @map("account_id")
  tenantId     String   @map("tenant_id") @db.VarChar(255)
  role         Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId])

  @@unique([accountId, tenantId])
  @@map("a2_tenant_membership")
}

model OAuthClient {
  clientId     String   @id @map("client_id") @db.VarChar(255)
  clientSecret String   @map("client_secret") @db.VarChar(255)
  clientName   String   @map("client_name") @db.VarChar(255)
  tenantId     String   @map("tenant_id") @db.VarChar(255)
  redirectUris String[] @map("redirect_uris")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant             Tenant                   @relation(fields: [tenantId], references: [tenantId])
  authorizationCodes OAuthAuthorizationCode[]
  refreshTokens      OAuthRefreshToken[]
  allowedAudiences   ClientAllowedAudience[]

  @@map("a2_oauth_client")
}

model OAuthAuthorizationCode {
  code                String   @id @db.VarChar(255)
  clientId            String   @map("client_id") @db.VarChar(255)
  accountId           Int      @map("account_id")
  redirectUri         String   @map("redirect_uri") @db.VarChar(512)
  codeChallenge       String?  @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String?  @map("code_challenge_method") @db.VarChar(10)
  scope               String?  @db.VarChar(512)
  audience            String?  @db.VarChar(255)
  expiresAt           DateTime @map("expires_at")
  used                Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")

  client  OAuthClient @relation(fields: [clientId], references: [clientId])
  account Account     @relation(fields: [accountId], references: [accountId])

  @@map("a2_oauth_authorization_code")
}

model OAuthRefreshToken {
  token     String   @id @db.VarChar(255)
  accountId Int      @map("account_id")
  clientId  String   @map("client_id") @db.VarChar(255)
  audience  String?  @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  account Account     @relation(fields: [accountId], references: [accountId])
  client  OAuthClient @relation(fields: [clientId], references: [clientId])

  @@map("a2_oauth_refresh_token")
}

// ============================================================
// v2 OAuth — Audience-Scoped Tokens (RS256 + JWKS)
// ============================================================

model ApiResource {
  id          String   @id @default(cuid()) @map("resource_id")
  tenantId    String   @map("tenant_id") @db.VarChar(255)
  identifier  String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant           Tenant                  @relation(fields: [tenantId], references: [tenantId])
  allowedAudiences ClientAllowedAudience[]

  @@unique([tenantId, identifier])
  @@map("a2_api_resource")
}

model ClientAllowedAudience {
  clientId      String   @map("client_id") @db.VarChar(255)
  apiResourceId String   @map("api_resource_id")
  createdAt     DateTime @default(now()) @map("created_at")

  client      OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  apiResource ApiResource @relation(fields: [apiResourceId], references: [id], onDelete: Cascade)

  @@id([clientId, apiResourceId])
  @@map("a2_client_allowed_audience")
}
