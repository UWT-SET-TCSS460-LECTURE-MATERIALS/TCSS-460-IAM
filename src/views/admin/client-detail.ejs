<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= client.clientName %> - Admin - Auth²</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YcnS/1Ysyl1FMJI55Rl0oIoU6SY22lFbOj0" crossorigin="anonymous">
    <style>
        body { background-color: #f8f9fa; }
        .secret-box {
            background: #fff3cd;
            border: 1px solid #ffc107;
            padding: 12px;
            border-radius: 6px;
            font-family: monospace;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <%- include('../partials/flash', { flash: typeof flash !== 'undefined' ? flash : {} }) %>

        <!-- New secret alert -->
        <% if (typeof newSecret !== 'undefined' && newSecret) { %>
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <strong>New Client Secret</strong> -- save it now, it will not be shown again.<br>
                <div class="secret-box mt-2"><%= newSecret %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/ui/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/ui/tenants/<%= tenant.tenantId %>"><%= tenant.tenantName %></a></li>
                <li class="breadcrumb-item active"><%= client.clientName %></li>
            </ol>
        </nav>

        <!-- Client Info -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1><%= client.clientName %></h1>
                <p class="text-muted mb-0">Tenant: <code><%= tenant.tenantId %></code></p>
            </div>
            <div class="d-flex gap-2">
                <form method="POST"
                      action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/rotate"
                      onsubmit="return confirm('Rotate secret? The old secret will stop working immediately.')">
                    <button type="submit" class="btn btn-warning">Rotate Secret</button>
                </form>
                <form method="POST"
                      action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/delete"
                      onsubmit="return confirm('Delete this client? All associated authorization codes and tokens will also be deleted. This cannot be undone.')">
                    <button type="submit" class="btn btn-danger">Delete Client</button>
                </form>
            </div>
        </div>

        <!-- Client ID -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Client Credentials</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Client ID</label>
                        <div class="form-control bg-light" style="font-family: monospace; word-break: break-all;">
                            <%= client.clientId %>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Client Secret</label>
                        <div class="form-control bg-light text-muted">
                            ************************************
                        </div>
                        <div class="form-text">Use "Rotate Secret" to generate a new secret.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Client Form -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Edit Client</h5>
            </div>
            <div class="card-body">
                <form method="POST"
                      action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/update">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="clientName" class="form-label">Client Name</label>
                            <input type="text" class="form-control" id="clientName" name="clientName"
                                   value="<%= client.clientName %>">
                        </div>
                        <div class="col-md-8">
                            <label for="redirectUris" class="form-label">Redirect URIs (one per line)</label>
                            <textarea class="form-control" id="redirectUris" name="redirectUris"
                                      rows="<%= Math.max(3, client.redirectUris.length + 1) %>"><%= client.redirectUris.join('\n') %></textarea>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Current Redirect URIs -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Registered Redirect URIs</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <% client.redirectUris.forEach(function(uri) { %>
                        <li class="list-group-item">
                            <code><%= uri %></code>
                        </li>
                    <% }); %>
                </ul>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
