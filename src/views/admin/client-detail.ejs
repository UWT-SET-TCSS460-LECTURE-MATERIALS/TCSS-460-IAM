<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= client.clientName %> - Admin - Auth²</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
         >
    <style>
        body { background-color: #f8f9fa; }
        .secret-box {
            background: #fff3cd;
            border: 1px solid #ffc107;
            padding: 12px;
            border-radius: 6px;
            font-family: monospace;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <%- include('../partials/flash', { flash: typeof flash !== 'undefined' ? flash : {} }) %>

        <!-- New secret alert -->
        <% if (typeof newSecret !== 'undefined' && newSecret) { %>
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <strong>New Client Secret</strong> -- save it now, it will not be shown again.<br>
                <div class="secret-box mt-2"><%= newSecret %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/ui/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/ui/tenants/<%= tenant.tenantId %>"><%= tenant.tenantName %></a></li>
                <li class="breadcrumb-item active"><%= client.clientName %></li>
            </ol>
        </nav>

        <!-- Client Info -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1><%= client.clientName %></h1>
                <p class="text-muted mb-0">Tenant: <code><%= tenant.tenantId %></code></p>
            </div>
            <div class="d-flex gap-2">
                <form method="POST"
                      action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/rotate"
                      onsubmit="return confirm('Rotate secret? The old secret will stop working immediately.')">
                    <button type="submit" class="btn btn-warning">Rotate Secret</button>
                </form>
                <form method="POST"
                      action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/delete"
                      onsubmit="return confirm('Delete this client? All associated authorization codes and tokens will also be deleted. This cannot be undone.')">
                    <button type="submit" class="btn btn-danger">Delete Client</button>
                </form>
            </div>
        </div>

        <!-- Client ID -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Client Credentials</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Client ID</label>
                        <div class="form-control bg-light" style="font-family: monospace; word-break: break-all;">
                            <%= client.clientId %>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Client Secret</label>
                        <div class="form-control bg-light text-muted">
                            ************************************
                        </div>
                        <div class="form-text">Use "Rotate Secret" to generate a new secret.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Client Form -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Edit Client</h5>
            </div>
            <div class="card-body">
                <form method="POST"
                      action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/update">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="clientName" class="form-label">Client Name</label>
                            <input type="text" class="form-control" id="clientName" name="clientName"
                                   value="<%= client.clientName %>">
                        </div>
                        <div class="col-md-8">
                            <label for="redirectUris" class="form-label">Redirect URIs (one per line)</label>
                            <textarea class="form-control" id="redirectUris" name="redirectUris"
                                      rows="<%= Math.max(3, client.redirectUris.length + 1) %>"><%= client.redirectUris.join('\n') %></textarea>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Current Redirect URIs -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Registered Redirect URIs</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <% client.redirectUris.forEach(function(uri) { %>
                        <li class="list-group-item">
                            <code><%= uri %></code>
                        </li>
                    <% }); %>
                </ul>
            </div>
        </div>

        <!-- Allowed Audiences -->
        <%
            var grantedSet = new Set(grantedAudienceIds || []);
            var grantedCount = (grantedAudienceIds || []).length;
        %>
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    Allowed Audiences (<%= grantedCount %>)
                    <small class="text-muted fw-normal ms-2">— APIs this client can mint tokens for</small>
                </h5>
            </div>
            <div class="card-body">
                <% if (!apiResources || apiResources.length === 0) { %>
                    <div class="text-center text-muted py-3">
                        This tenant has no API resources yet.
                        <a href="/admin/ui/tenants/<%= tenant.tenantId %>#createApiResourceForm">Create one</a> to grant audience access.
                    </div>
                <% } else { %>
                    <form method="POST"
                          action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/audiences">
                        <p class="text-muted small mb-3">
                            Tick the APIs this client is permitted to request tokens for.
                            The <code>audience</code> query parameter on <code>/v2/oauth/authorize</code> must match one of these identifiers.
                        </p>
                        <div class="row g-2">
                            <% apiResources.forEach(function(resource) { %>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="audienceIds"
                                               id="aud-<%= resource.id %>"
                                               value="<%= resource.id %>"
                                               <%= grantedSet.has(resource.id) ? 'checked' : '' %>>
                                        <label class="form-check-label" for="aud-<%= resource.id %>">
                                            <code class="small"><%= resource.identifier %></code>
                                            <span class="text-muted small ms-1">— <%= resource.displayName %></span>
                                        </label>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <div class="mt-3 d-flex gap-2 align-items-center">
                            <button type="submit" class="btn btn-primary">Save Grants</button>
                            <small class="text-muted">Changes apply immediately; existing tokens are unaffected.</small>
                        </div>
                    </form>
                <% } %>
            </div>
        </div>

        <!-- Test This Client -->
        <%
            var grantedResources = (apiResources || []).filter(function(r) {
                return grantedSet.has(r.id);
            });
        %>
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    Test This Client
                    <small class="text-muted fw-normal ms-2">— mint an RS256 token for smoke-testing</small>
                </h5>
            </div>
            <div class="card-body">
                <% if (typeof mintedToken !== 'undefined' && mintedToken) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Test token minted.</strong> Claims:
                        <code class="small d-inline-block ms-1">
                            sub=<%= mintedToken.claims.sub %> ·
                            aud=<%= mintedToken.claims.aud %> ·
                            role=<%= mintedToken.claims.role %>
                        </code>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

                        <div class="mt-2">
                            <label class="form-label fw-bold small mb-1">access_token</label>
                            <div class="secret-box"><%= mintedToken.access_token %></div>
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="navigator.clipboard.writeText(this.parentElement.previousElementSibling.innerText)">
                                    Copy access_token
                                </button>
                                <a href="https://jwt.io" target="_blank" rel="noopener"
                                   class="btn btn-sm btn-outline-secondary">Decode on jwt.io</a>
                            </div>
                        </div>
                    </div>
                <% } %>

                <% if (grantedResources.length === 0) { %>
                    <div class="text-center text-muted py-3">
                        Grant this client at least one audience above, then come back to mint a test token.
                    </div>
                <% } else if (!members || members.length === 0) { %>
                    <div class="text-center text-muted py-3">
                        This tenant has no members. Add a member first; test tokens are minted for a specific user account.
                    </div>
                <% } else { %>
                    <form method="POST"
                          action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/mint-token">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label for="mintAudience" class="form-label">Audience</label>
                                <select class="form-select" id="mintAudience" name="audience" required>
                                    <% grantedResources.forEach(function(r) { %>
                                        <option value="<%= r.identifier %>"><%= r.identifier %></option>
                                    <% }); %>
                                </select>
                                <div class="form-text">Only audiences this client is granted.</div>
                            </div>
                            <div class="col-md-5">
                                <label for="mintAccountId" class="form-label">Mint token for user</label>
                                <select class="form-select" id="mintAccountId" name="accountId" required>
                                    <% members.forEach(function(m) { %>
                                        <option value="<%= m.accountId %>">
                                            <%= m.firstName %> <%= m.lastName %> &lt;<%= m.email %>&gt;
                                            — role <%= m.roleLevel %>
                                        </option>
                                    <% }); %>
                                </select>
                                <div class="form-text text-warning">
                                    Minting for another user bypasses login. For diagnostics only.
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label for="mintExpires" class="form-label">TTL</label>
                                <select class="form-select" id="mintExpires" name="expiresIn">
                                    <option value="5m">5m</option>
                                    <option value="1h" selected>1h</option>
                                    <option value="24h">24h</option>
                                </select>
                            </div>
                            <div class="col-md-1">
                                <button type="submit" class="btn btn-primary w-100">Mint</button>
                            </div>
                        </div>
                    </form>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
           ></script>
</body>
</html>
