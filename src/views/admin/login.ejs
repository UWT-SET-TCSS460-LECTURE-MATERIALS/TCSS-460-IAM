<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login — Auth²</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
         >
    <style>
        body { background-color: #f8f9fa; }
        .auth-card {
            max-width: 440px;
            margin: 80px auto;
            border-top: 4px solid #dc3545;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card auth-card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-4">Auth² Admin</h4>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form method="POST" action="/admin/ui/login">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                    </div>
                    <button type="submit" class="btn btn-danger w-100">Sign In</button>
                </form>

                <p class="text-muted text-center small mt-3 mb-0">Only Owner-level accounts can access the admin panel.</p>
            </div>
        </div>
    </div>
</body>
</html>
