<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= resource.identifier %> - Admin - Auth²</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
    </style>
</head>
<body>
    <div class="container py-4">
        <%- include('../partials/flash', { flash: typeof flash !== 'undefined' ? flash : {} }) %>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/ui/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/ui/tenants/<%= tenant.tenantId %>"><%= tenant.tenantName %></a></li>
                <li class="breadcrumb-item active"><%= resource.identifier %></li>
            </ol>
        </nav>

        <!-- Resource header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1><%= resource.displayName %></h1>
                <p class="text-muted mb-0">
                    Audience: <code><%= resource.identifier %></code>
                    <span class="ms-2 small">· Tenant: <code><%= tenant.tenantId %></code></span>
                </p>
            </div>
            <form method="POST"
                  action="/admin/ui/tenants/<%= tenant.tenantId %>/api-resources/<%= resource.id %>/delete"
                  onsubmit="return confirm('Delete API resource &quot;<%= resource.identifier %>&quot;? All client grants for this audience will also be removed.')">
                <button type="submit" class="btn btn-outline-danger">Delete Resource</button>
            </form>
        </div>

        <!-- Usage hint -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Usage</h5>
            </div>
            <div class="card-body">
                <p class="mb-2 small">
                    Clients granted access below can request this audience via:
                </p>
                <pre class="bg-light p-3 rounded small mb-0"><code>GET /v2/oauth/authorize?client_id=&lt;client-id&gt;&amp;audience=<%= resource.identifier %>&amp;redirect_uri=...&amp;response_type=code</code></pre>
            </div>
        </div>

        <!-- Clients with grants -->
        <%
            var grants = resource.allowedAudiences || [];
        %>
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    Granted Clients (<%= grants.length %>)
                    <small class="text-muted fw-normal ms-2">— OAuth clients permitted to mint tokens for this audience</small>
                </h5>
            </div>
            <div class="card-body p-0">
                <% if (grants.length === 0) { %>
                    <div class="p-4 text-center text-muted">
                        No clients have been granted access to this audience.
                        Open a client's detail page and tick this audience under "Allowed Audiences" to grant access.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Client ID</th>
                                    <th>Client Name</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% grants.forEach(function(g) { %>
                                    <tr>
                                        <td><code class="small"><%= g.client.clientId %></code></td>
                                        <td><%= g.client.clientName %></td>
                                        <td class="text-end">
                                            <a href="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= g.client.clientId %>"
                                               class="btn btn-sm btn-outline-primary">Manage Client</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
