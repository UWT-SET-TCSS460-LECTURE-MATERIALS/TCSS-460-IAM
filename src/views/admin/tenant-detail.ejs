<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= tenant.tenantName %> - Admin - Auth²</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
         >
    <style>
        body { background-color: #f8f9fa; }
        .color-swatch-lg {
            display: inline-block;
            width: 24px;
            height: 24px;
            border-radius: 4px;
            border: 1px solid #dee2e6;
            vertical-align: middle;
        }
        .secret-box {
            background: #fff3cd;
            border: 1px solid #ffc107;
            padding: 12px;
            border-radius: 6px;
            font-family: monospace;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <%- include('../partials/flash', { flash: typeof flash !== 'undefined' ? flash : {} }) %>

        <!-- New client secret alert -->
        <% if (typeof newClientSecret !== 'undefined' && newClientSecret) { %>
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <strong>New Client Created!</strong> Save the secret now -- it will not be shown again.<br>
                <strong>Client ID:</strong> <code><%= newClientId %></code><br>
                <div class="secret-box mt-2"><%= newClientSecret %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/ui/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active"><%= tenant.tenantName %></li>
            </ol>
        </nav>

        <!-- Tenant Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1>
                    <% if (tenant.brandingColor) { %>
                        <span class="color-swatch-lg me-2" style="background-color: <%= tenant.brandingColor %>"></span>
                    <% } %>
                    <%= tenant.tenantName %>
                </h1>
                <p class="text-muted mb-0">
                    <code><%= tenant.tenantId %></code>
                    <% if (tenant.isActive) { %>
                        <span class="badge bg-success ms-2">Active</span>
                    <% } else { %>
                        <span class="badge bg-secondary ms-2">Inactive</span>
                    <% } %>
                </p>
                <% if (tenant.description) { %>
                    <p class="text-muted mt-1"><%= tenant.description %></p>
                <% } %>
            </div>
            <div>
                <% if (tenant.isActive) { %>
                    <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/deactivate"
                          onsubmit="return confirm('Are you sure you want to deactivate this tenant? This will not delete data but will prevent new logins.')">
                        <button type="submit" class="btn btn-outline-danger">Deactivate Tenant</button>
                    </form>
                <% } %>
            </div>
        </div>

        <!-- Edit Tenant Form -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Tenant Settings</h5>
            </div>
            <div class="card-body">
                <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/update">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="tenantName" class="form-label">Tenant Name</label>
                            <input type="text" class="form-control" id="tenantName" name="tenantName"
                                   value="<%= tenant.tenantName %>">
                        </div>
                        <div class="col-md-4">
                            <label for="brandingName" class="form-label">Branding Name</label>
                            <input type="text" class="form-control" id="brandingName" name="brandingName"
                                   value="<%= tenant.brandingName || '' %>">
                        </div>
                        <div class="col-md-2">
                            <label for="brandingColor" class="form-label">Branding Color</label>
                            <input type="color" class="form-control form-control-color" id="brandingColor"
                                   name="brandingColor" value="<%= tenant.brandingColor || '#0d6efd' %>">
                        </div>
                        <div class="col-md-2">
                            <label for="defaultRole" class="form-label">Default Role</label>
                            <select class="form-select" id="defaultRole" name="defaultRole">
                                <option value="1" <%= tenant.defaultRole === 1 ? 'selected' : '' %>>User (1)</option>
                                <option value="2" <%= tenant.defaultRole === 2 ? 'selected' : '' %>>Moderator (2)</option>
                                <option value="3" <%= tenant.defaultRole === 3 ? 'selected' : '' %>>Admin (3)</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label for="description" class="form-label">Description</label>
                            <input type="text" class="form-control" id="description" name="description"
                                   value="<%= tenant.description || '' %>">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check me-3">
                                <input class="form-check-input" type="checkbox" id="autoProvision"
                                       name="autoProvision" <%= tenant.autoProvision ? 'checked' : '' %>>
                                <label class="form-check-label" for="autoProvision">Auto-provision new users</label>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- OAuth Clients Section -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">OAuth Clients (<%= tenant.clients.length %>)</h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#createClientForm">
                    Create Client
                </button>
            </div>

            <!-- Create Client Form (collapsed) -->
            <div class="collapse" id="createClientForm">
                <div class="card-body border-bottom bg-light">
                    <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/clients">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="clientName" class="form-label">Client Name</label>
                                <input type="text" class="form-control" id="clientName" name="clientName"
                                       placeholder="e.g., Group 1 App" required>
                            </div>
                            <div class="col-md-8">
                                <label for="redirectUris" class="form-label">Redirect URIs (one per line)</label>
                                <textarea class="form-control" id="redirectUris" name="redirectUris" rows="2"
                                          placeholder="http://localhost:3000/api/auth/callback/tcss460" required></textarea>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary btn-sm">Create Client</button>
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse"
                                    data-bs-target="#createClientForm">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card-body p-0">
                <% if (tenant.clients.length === 0) { %>
                    <div class="p-4 text-center text-muted">No OAuth clients. Create one to enable OAuth2 login.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Client ID</th>
                                    <th>Name</th>
                                    <th>Redirect URIs</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% tenant.clients.forEach(function(client) { %>
                                    <tr>
                                        <td><code class="small"><%= client.clientId %></code></td>
                                        <td><%= client.clientName %></td>
                                        <td>
                                            <% client.redirectUris.forEach(function(uri) { %>
                                                <div class="small text-muted"><%= uri %></div>
                                            <% }); %>
                                        </td>
                                        <td>
                                            <a href="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>"
                                               class="btn btn-sm btn-outline-primary me-1">Detail</a>
                                            <form method="POST" class="d-inline"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/rotate"
                                                  onsubmit="return confirm('Rotate secret? The old secret will stop working immediately.')">
                                                <button type="submit" class="btn btn-sm btn-outline-warning me-1">Rotate Secret</button>
                                            </form>
                                            <form method="POST" class="d-inline"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/delete"
                                                  onsubmit="return confirm('Delete this client? All associated authorization codes and tokens will also be deleted.')">
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- API Resources (Audiences) Section -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    API Resources (<%= apiResources.length %>)
                    <small class="text-muted fw-normal ms-2">— audiences that tokens can be minted for</small>
                </h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#createApiResourceForm">
                    + API Resource
                </button>
            </div>

            <!-- Create API Resource Form (collapsed) -->
            <div class="collapse" id="createApiResourceForm">
                <div class="card-body border-bottom bg-light">
                    <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/api-resources">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label for="identifier" class="form-label">Identifier</label>
                                <input type="text" class="form-control" id="identifier" name="identifier"
                                       placeholder="e.g., group-1-api" required>
                                <div class="form-text">Used as the <code>aud</code> claim in tokens. Stable, URL-safe.</div>
                            </div>
                            <div class="col-md-7">
                                <label for="displayName" class="form-label">Display Name</label>
                                <input type="text" class="form-control" id="displayName" name="displayName"
                                       placeholder="e.g., Group 1 API" required>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary btn-sm">Create API Resource</button>
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse"
                                    data-bs-target="#createApiResourceForm">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card-body p-0">
                <% if (apiResources.length === 0) { %>
                    <div class="p-4 text-center text-muted">
                        No API resources yet. Create one to allow clients in this tenant to request audience-scoped tokens.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Identifier</th>
                                    <th>Display Name</th>
                                    <th>Granted Clients</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% apiResources.forEach(function(resource) { %>
                                    <tr>
                                        <td><code class="small"><%= resource.identifier %></code></td>
                                        <td><%= resource.displayName %></td>
                                        <td>
                                            <% if (!resource.allowedAudiences || resource.allowedAudiences.length === 0) { %>
                                                <span class="text-muted small">None</span>
                                            <% } else { %>
                                                <span class="badge bg-light text-dark border"><%= resource.allowedAudiences.length %></span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <a href="/admin/ui/tenants/<%= tenant.tenantId %>/api-resources/<%= resource.id %>"
                                               class="btn btn-sm btn-outline-primary me-1">Detail</a>
                                            <form method="POST" class="d-inline"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/api-resources/<%= resource.id %>/delete"
                                                  onsubmit="return confirm('Delete API resource &quot;<%= resource.identifier %>&quot;? All client grants for this audience will also be removed.')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Members Section -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Members (<%= pagination.totalMembers %>)</h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#addMemberForm">
                    Add Member
                </button>
            </div>

            <!-- Add Member Form (collapsed) -->
            <div class="collapse" id="addMemberForm">
                <div class="card-body border-bottom bg-light">
                    <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/members">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label for="memberEmail" class="form-label">Email Address</label>
                                <input type="email" class="form-control" id="memberEmail" name="email"
                                       placeholder="user@example.com" required>
                                <div class="form-text">The user must already have an Auth² account.</div>
                            </div>
                            <div class="col-md-3">
                                <label for="memberRole" class="form-label">Role</label>
                                <select class="form-select" id="memberRole" name="role">
                                    <option value="1" selected>User (1)</option>
                                    <option value="2">Moderator (2)</option>
                                    <option value="3">Admin (3)</option>
                                    <option value="4">SuperAdmin (4)</option>
                                    <option value="5">Owner (5)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary">Add Member</button>
                                <button type="button" class="btn btn-secondary" data-bs-toggle="collapse"
                                        data-bs-target="#addMemberForm">Cancel</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card-body p-0">
                <% if (members.length === 0) { %>
                    <div class="p-4 text-center text-muted">No members in this tenant.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Username</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% members.forEach(function(member) { %>
                                    <tr>
                                        <td>
                                            <form method="POST" class="d-inline"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/members/<%= member.accountId %>/edit">
                                                <div class="input-group input-group-sm" style="max-width: 260px;">
                                                    <input type="text" class="form-control" name="firstName"
                                                           value="<%= member.firstName %>" style="max-width: 110px;">
                                                    <input type="text" class="form-control" name="lastName"
                                                           value="<%= member.lastName %>" style="max-width: 110px;">
                                                    <button type="submit" class="btn btn-outline-secondary" title="Save name">Save</button>
                                                </div>
                                            </form>
                                        </td>
                                        <td>
                                            <form method="POST" class="d-inline"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/members/<%= member.accountId %>/edit">
                                                <div class="input-group input-group-sm" style="max-width: 280px;">
                                                    <input type="email" class="form-control" name="email"
                                                           value="<%= member.email %>">
                                                    <button type="submit" class="btn btn-outline-secondary" title="Save email">Save</button>
                                                </div>
                                            </form>
                                        </td>
                                        <td><code class="small"><%= member.username %></code></td>
                                        <td>
                                            <form method="POST" class="d-flex align-items-center gap-1"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/members/<%= member.accountId %>/role">
                                                <select class="form-select form-select-sm" name="role" style="width: auto;">
                                                    <option value="1" <%= member.roleLevel === 1 ? 'selected' : '' %>>User</option>
                                                    <option value="2" <%= member.roleLevel === 2 ? 'selected' : '' %>>Moderator</option>
                                                    <option value="3" <%= member.roleLevel === 3 ? 'selected' : '' %>>Admin</option>
                                                    <option value="4" <%= member.roleLevel === 4 ? 'selected' : '' %>>SuperAdmin</option>
                                                    <option value="5" <%= member.roleLevel === 5 ? 'selected' : '' %>>Owner</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                                            </form>
                                        </td>
                                        <td>
                                            <% var isActive = member.accountStatus === 'active'; %>
                                            <form method="POST" class="d-flex align-items-center gap-1"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/members/<%= member.accountId %>/status">
                                                <input type="hidden" name="status" value="<%= isActive ? 'suspended' : 'active' %>">
                                                <span class="badge bg-<%= isActive ? 'success' : (member.accountStatus === 'pending' ? 'warning' : 'secondary') %>">
                                                    <%= member.accountStatus %>
                                                </span>
                                                <button type="submit" class="btn btn-sm btn-outline-<%= isActive ? 'secondary' : 'success' %>"
                                                        title="<%= isActive ? 'Suspend account' : 'Activate account' %>">
                                                    <%= isActive ? 'Suspend' : 'Activate' %>
                                                </button>
                                            </form>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-warning me-1"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#resetPwModal-<%= member.accountId %>"
                                                    title="Reset password">PW</button>
                                            <form method="POST" class="d-inline"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/members/<%= member.accountId %>/remove"
                                                  onsubmit="return confirm('Remove <%= member.firstName %> <%= member.lastName %> from this tenant?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>

                                            <!-- Reset Password Modal -->
                                            <div class="modal fade" id="resetPwModal-<%= member.accountId %>" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-sm">
                                                    <div class="modal-content">
                                                        <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/members/<%= member.accountId %>/reset-password">
                                                            <div class="modal-header">
                                                                <h6 class="modal-title">Reset Password</h6>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="small text-muted mb-2"><%= member.firstName %> <%= member.lastName %></p>
                                                                <label for="pw-<%= member.accountId %>" class="form-label">New Password</label>
                                                                <input type="password" class="form-control" id="pw-<%= member.accountId %>"
                                                                       name="password" minlength="8" required>
                                                                <div class="form-text">Min 8 characters.</div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-sm btn-warning">Reset</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (pagination.totalPages > 1) { %>
                        <nav class="p-3">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link"
                                       href="/admin/ui/tenants/<%= tenant.tenantId %>?page=<%= pagination.page - 1 %>">Previous</a>
                                </li>
                                <% for (var i = 1; i <= pagination.totalPages; i++) { %>
                                    <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                                        <a class="page-link"
                                           href="/admin/ui/tenants/<%= tenant.tenantId %>?page=<%= i %>"><%= i %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link"
                                       href="/admin/ui/tenants/<%= tenant.tenantId %>?page=<%= pagination.page + 1 %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
           ></script>
</body>
</html>
