<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= tenant.tenantName %> - Admin - Auth²</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YcnS/1Ysyl1FMJI55Rl0oIoU6SY22lFbOj0" crossorigin="anonymous">
    <style>
        body { background-color: #f8f9fa; }
        .color-swatch-lg {
            display: inline-block;
            width: 24px;
            height: 24px;
            border-radius: 4px;
            border: 1px solid #dee2e6;
            vertical-align: middle;
        }
        .secret-box {
            background: #fff3cd;
            border: 1px solid #ffc107;
            padding: 12px;
            border-radius: 6px;
            font-family: monospace;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <%- include('../partials/flash', { flash: typeof flash !== 'undefined' ? flash : {} }) %>

        <!-- New client secret alert -->
        <% if (typeof newClientSecret !== 'undefined' && newClientSecret) { %>
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <strong>New Client Created!</strong> Save the secret now -- it will not be shown again.<br>
                <strong>Client ID:</strong> <code><%= newClientId %></code><br>
                <div class="secret-box mt-2"><%= newClientSecret %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/ui/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active"><%= tenant.tenantName %></li>
            </ol>
        </nav>

        <!-- Tenant Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1>
                    <% if (tenant.brandingColor) { %>
                        <span class="color-swatch-lg me-2" style="background-color: <%= tenant.brandingColor %>"></span>
                    <% } %>
                    <%= tenant.tenantName %>
                </h1>
                <p class="text-muted mb-0">
                    <code><%= tenant.tenantId %></code>
                    <% if (tenant.isActive) { %>
                        <span class="badge bg-success ms-2">Active</span>
                    <% } else { %>
                        <span class="badge bg-secondary ms-2">Inactive</span>
                    <% } %>
                </p>
                <% if (tenant.description) { %>
                    <p class="text-muted mt-1"><%= tenant.description %></p>
                <% } %>
            </div>
            <div>
                <% if (tenant.isActive) { %>
                    <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/deactivate"
                          onsubmit="return confirm('Are you sure you want to deactivate this tenant? This will not delete data but will prevent new logins.')">
                        <button type="submit" class="btn btn-outline-danger">Deactivate Tenant</button>
                    </form>
                <% } %>
            </div>
        </div>

        <!-- Edit Tenant Form -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Tenant Settings</h5>
            </div>
            <div class="card-body">
                <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/update">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="tenantName" class="form-label">Tenant Name</label>
                            <input type="text" class="form-control" id="tenantName" name="tenantName"
                                   value="<%= tenant.tenantName %>">
                        </div>
                        <div class="col-md-4">
                            <label for="brandingName" class="form-label">Branding Name</label>
                            <input type="text" class="form-control" id="brandingName" name="brandingName"
                                   value="<%= tenant.brandingName || '' %>">
                        </div>
                        <div class="col-md-2">
                            <label for="brandingColor" class="form-label">Branding Color</label>
                            <input type="color" class="form-control form-control-color" id="brandingColor"
                                   name="brandingColor" value="<%= tenant.brandingColor || '#0d6efd' %>">
                        </div>
                        <div class="col-md-2">
                            <label for="defaultRole" class="form-label">Default Role</label>
                            <select class="form-select" id="defaultRole" name="defaultRole">
                                <option value="1" <%= tenant.defaultRole === 1 ? 'selected' : '' %>>User (1)</option>
                                <option value="2" <%= tenant.defaultRole === 2 ? 'selected' : '' %>>Moderator (2)</option>
                                <option value="3" <%= tenant.defaultRole === 3 ? 'selected' : '' %>>Admin (3)</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label for="description" class="form-label">Description</label>
                            <input type="text" class="form-control" id="description" name="description"
                                   value="<%= tenant.description || '' %>">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check me-3">
                                <input class="form-check-input" type="checkbox" id="autoProvision"
                                       name="autoProvision" <%= tenant.autoProvision ? 'checked' : '' %>>
                                <label class="form-check-label" for="autoProvision">Auto-provision new users</label>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- OAuth Clients Section -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">OAuth Clients (<%= tenant.clients.length %>)</h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#createClientForm">
                    Create Client
                </button>
            </div>

            <!-- Create Client Form (collapsed) -->
            <div class="collapse" id="createClientForm">
                <div class="card-body border-bottom bg-light">
                    <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/clients">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="clientName" class="form-label">Client Name</label>
                                <input type="text" class="form-control" id="clientName" name="clientName"
                                       placeholder="e.g., Group 1 App" required>
                            </div>
                            <div class="col-md-8">
                                <label for="redirectUris" class="form-label">Redirect URIs (one per line)</label>
                                <textarea class="form-control" id="redirectUris" name="redirectUris" rows="2"
                                          placeholder="http://localhost:3000/api/auth/callback/tcss460" required></textarea>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary btn-sm">Create Client</button>
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse"
                                    data-bs-target="#createClientForm">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card-body p-0">
                <% if (tenant.clients.length === 0) { %>
                    <div class="p-4 text-center text-muted">No OAuth clients. Create one to enable OAuth2 login.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Client ID</th>
                                    <th>Name</th>
                                    <th>Redirect URIs</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% tenant.clients.forEach(function(client) { %>
                                    <tr>
                                        <td><code class="small"><%= client.clientId %></code></td>
                                        <td><%= client.clientName %></td>
                                        <td>
                                            <% client.redirectUris.forEach(function(uri) { %>
                                                <div class="small text-muted"><%= uri %></div>
                                            <% }); %>
                                        </td>
                                        <td>
                                            <a href="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>"
                                               class="btn btn-sm btn-outline-primary me-1">Detail</a>
                                            <form method="POST" class="d-inline"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/rotate"
                                                  onsubmit="return confirm('Rotate secret? The old secret will stop working immediately.')">
                                                <button type="submit" class="btn btn-sm btn-outline-warning me-1">Rotate Secret</button>
                                            </form>
                                            <form method="POST" class="d-inline"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/clients/<%= client.clientId %>/delete"
                                                  onsubmit="return confirm('Delete this client? All associated authorization codes and tokens will also be deleted.')">
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Members Section -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Members (<%= pagination.totalMembers %>)</h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#addMemberForm">
                    Add Member
                </button>
            </div>

            <!-- Add Member Form (collapsed) -->
            <div class="collapse" id="addMemberForm">
                <div class="card-body border-bottom bg-light">
                    <form method="POST" action="/admin/ui/tenants/<%= tenant.tenantId %>/members">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="accountId" class="form-label">Account ID</label>
                                <input type="number" class="form-control" id="accountId" name="accountId"
                                       placeholder="e.g., 42" required>
                            </div>
                            <div class="col-md-4">
                                <label for="memberRole" class="form-label">Role</label>
                                <select class="form-select" id="memberRole" name="role">
                                    <option value="1" selected>User (1)</option>
                                    <option value="2">Moderator (2)</option>
                                    <option value="3">Admin (3)</option>
                                    <option value="4">SuperAdmin (4)</option>
                                    <option value="5">Owner (5)</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary btn-sm">Add Member</button>
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse"
                                    data-bs-target="#addMemberForm">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card-body p-0">
                <% if (members.length === 0) { %>
                    <div class="p-4 text-center text-muted">No members in this tenant.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% members.forEach(function(member) { %>
                                    <tr>
                                        <td><%= member.accountId %></td>
                                        <td><%= member.firstName %> <%= member.lastName %></td>
                                        <td><%= member.email %></td>
                                        <td>
                                            <form method="POST" class="d-flex align-items-center gap-1"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/members/<%= member.accountId %>/role">
                                                <select class="form-select form-select-sm" name="role" style="width: auto;">
                                                    <option value="1" <%= member.roleLevel === 1 ? 'selected' : '' %>>User (1)</option>
                                                    <option value="2" <%= member.roleLevel === 2 ? 'selected' : '' %>>Moderator (2)</option>
                                                    <option value="3" <%= member.roleLevel === 3 ? 'selected' : '' %>>Admin (3)</option>
                                                    <option value="4" <%= member.roleLevel === 4 ? 'selected' : '' %>>SuperAdmin (4)</option>
                                                    <option value="5" <%= member.roleLevel === 5 ? 'selected' : '' %>>Owner (5)</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                                            </form>
                                        </td>
                                        <td>
                                            <form method="POST"
                                                  action="/admin/ui/tenants/<%= tenant.tenantId %>/members/<%= member.accountId %>/remove"
                                                  onsubmit="return confirm('Remove this member from the tenant?')">
                                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (pagination.totalPages > 1) { %>
                        <nav class="p-3">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link"
                                       href="/admin/ui/tenants/<%= tenant.tenantId %>?page=<%= pagination.page - 1 %>">Previous</a>
                                </li>
                                <% for (var i = 1; i <= pagination.totalPages; i++) { %>
                                    <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                                        <a class="page-link"
                                           href="/admin/ui/tenants/<%= tenant.tenantId %>?page=<%= i %>"><%= i %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link"
                                       href="/admin/ui/tenants/<%= tenant.tenantId %>?page=<%= pagination.page + 1 %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
