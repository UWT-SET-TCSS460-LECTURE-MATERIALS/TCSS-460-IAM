<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Auth²</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .color-swatch {
            display: inline-block;
            width: 16px;
            height: 16px;
            border-radius: 3px;
            border: 1px solid #dee2e6;
            vertical-align: middle;
        }
        .navbar-brand-icon {
            font-weight: 700;
            font-size: 1.25rem;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand navbar-brand-icon" href="/admin/ui/dashboard">
                Auth² <span class="badge bg-danger ms-2 fs-6 fw-normal">Admin</span>
            </a>
            <div class="navbar-nav ms-auto d-flex flex-row gap-3 align-items-center">
                <a class="nav-link text-light" href="/api-docs" target="_blank">API Docs</a>
                <a class="nav-link text-light" href="/health" target="_blank">Health</a>
                <form method="POST" action="/admin/ui/logout" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        <%- include('../partials/flash', { flash: typeof flash !== 'undefined' ? flash : {} }) %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Tenant Management</h2>
                <p class="text-muted mb-0">Manage tenants, OAuth clients, and memberships</p>
            </div>
            <button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#createTenantForm">
                + Create Tenant
            </button>
        </div>

        <!-- Create Tenant Form (collapsed) -->
        <div class="collapse mb-4" id="createTenantForm">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Create New Tenant</h5>
                </div>
                <div class="card-body">
                    <form method="POST" action="/admin/ui/tenants">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="tenantId" class="form-label">Tenant ID</label>
                                <input type="text" class="form-control" id="tenantId" name="tenantId"
                                       placeholder="e.g., tcss460-sp26" required>
                                <div class="form-text">URL-safe identifier, cannot be changed later.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="tenantName" class="form-label">Tenant Name</label>
                                <input type="text" class="form-control" id="tenantName" name="tenantName"
                                       placeholder="e.g., TCSS 460 Spring 2026" required>
                            </div>
                            <div class="col-md-4">
                                <label for="brandingName" class="form-label">Branding Name</label>
                                <input type="text" class="form-control" id="brandingName" name="brandingName"
                                       placeholder="e.g., TCSS 460">
                                <div class="form-text">Shown on the OAuth login page.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="description" class="form-label">Description</label>
                                <input type="text" class="form-control" id="description" name="description">
                            </div>
                            <div class="col-md-2">
                                <label for="brandingColor" class="form-label">Branding Color</label>
                                <input type="color" class="form-control form-control-color" id="brandingColor"
                                       name="brandingColor" value="#0d6efd">
                            </div>
                            <div class="col-md-2">
                                <label for="defaultRole" class="form-label">Default Role</label>
                                <select class="form-select" id="defaultRole" name="defaultRole">
                                    <option value="1" selected>User (1)</option>
                                    <option value="2">Moderator (2)</option>
                                    <option value="3">Admin (3)</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="autoProvision"
                                           name="autoProvision" checked>
                                    <label class="form-check-label" for="autoProvision">Auto-provision</label>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">Create Tenant</button>
                            <button type="button" class="btn btn-secondary" data-bs-toggle="collapse"
                                    data-bs-target="#createTenantForm">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tenants Table -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Tenants (<%= tenants.length %>)</h5>
            </div>
            <div class="card-body p-0">
                <% if (tenants.length === 0) { %>
                    <div class="p-4 text-center text-muted">No tenants found. Create one to get started.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tenant</th>
                                    <th>Status</th>
                                    <th>Members</th>
                                    <th>Clients</th>
                                    <th>Auto-Provision</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% tenants.forEach(function(tenant) { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <% if (tenant.brandingColor) { %>
                                                    <span class="color-swatch me-2" style="background-color: <%= tenant.brandingColor %>"></span>
                                                <% } %>
                                                <div>
                                                    <div class="fw-semibold"><%= tenant.tenantName %></div>
                                                    <code class="text-muted small"><%= tenant.tenantId %></code>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <% if (tenant.isActive) { %>
                                                <span class="badge bg-success">Active</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">Inactive</span>
                                            <% } %>
                                        </td>
                                        <td><span class="badge bg-light text-dark border"><%= tenant.memberCount %></span></td>
                                        <td><span class="badge bg-light text-dark border"><%= tenant.clientCount %></span></td>
                                        <td>
                                            <% if (tenant.autoProvision) { %>
                                                <span class="badge bg-info text-dark">Yes</span>
                                            <% } else { %>
                                                <span class="badge bg-warning text-dark">No</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <a href="/admin/ui/tenants/<%= tenant.tenantId %>"
                                               class="btn btn-sm btn-outline-primary">Manage</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-muted mt-4 small">
            Auth² — Multi-Tenant OAuth2 Authentication Service
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
