<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Auth&sup2;</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .secret-box {
            background: #fff3cd;
            border: 1px solid #ffc107;
            padding: 12px 16px;
            border-radius: 6px;
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 1.25rem;
            word-break: break-all;
            user-select: all;
        }
    </style>
</head>
<body>
    <div class="container py-4" style="max-width: 720px;">
        <h2 class="mb-3">Temporary password issued</h2>

        <div class="alert alert-warning" role="alert">
            <strong>Copy this password now.</strong> It will not be shown again.
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="mb-2">
                    <span class="text-muted">For:</span>
                    <strong><%= email %></strong>
                </div>
                <label class="text-muted small mb-1">Temporary password</label>
                <div class="secret-box mb-2" id="tempPw"><%= tempPassword %></div>
                <button type="button" class="btn btn-sm btn-outline-primary" id="copyBtn">
                    Copy to clipboard
                </button>
                <span class="ms-2 small text-success" id="copyOk" style="display:none;">Copied!</span>
            </div>
        </div>

        <div class="alert alert-info" role="alert">
            <strong>What happens next:</strong> The user will be required to
            change this password the first time they sign in. They cannot use
            tokens or access tenant systems until they do.
        </div>

        <div class="d-flex gap-2">
            <a href="/admin/ui/tenants/<%= tenantId %>" class="btn btn-secondary">
                Done &mdash; back to tenant
            </a>
        </div>
    </div>

    <script>
        document.getElementById('copyBtn').addEventListener('click', async () => {
            const pw = document.getElementById('tempPw').textContent.trim();
            try {
                await navigator.clipboard.writeText(pw);
                const ok = document.getElementById('copyOk');
                ok.style.display = 'inline';
                setTimeout(() => { ok.style.display = 'none'; }, 2000);
            } catch (_) {
                // Fallback: select the text so the user can ⌘C
                const range = document.createRange();
                range.selectNodeContents(document.getElementById('tempPw'));
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);
            }
        });
    </script>
</body>
</html>
