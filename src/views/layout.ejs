<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Auth²' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
         >
    <style>
        :root {
            --tenant-color: <%= typeof tenantColor !== 'undefined' ? tenantColor : '#0d6efd' %>;
        }
        body { background-color: #f8f9fa; }
        .auth-card {
            max-width: 440px;
            margin: 60px auto;
            border-top: 4px solid var(--tenant-color);
        }
        .btn-tenant {
            background-color: var(--tenant-color);
            border-color: var(--tenant-color);
            color: white;
        }
        .btn-tenant:hover {
            filter: brightness(0.9);
            color: white;
        }
    </style>
    <%- typeof head !== 'undefined' ? head : '' %>
</head>
<body>
    <div class="container">
        <%- typeof flash !== 'undefined' ? include('partials/flash', { flash }) : '' %>
        <%- body %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
           ></script>
</body>
</html>
