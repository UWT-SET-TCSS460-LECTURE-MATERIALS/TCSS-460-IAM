<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authorization Error — Auth²</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
         >
    <style>
        body { background-color: #f8f9fa; }
        .auth-card {
            max-width: 440px;
            margin: 60px auto;
            border-top: 4px solid #4b2e83;
        }
        .auth-logo { width: 64px; height: 64px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card auth-card shadow-sm">
            <div class="card-body p-4 text-center">
                <img src="/images/logo.svg" alt="Auth²" class="auth-logo mb-3">
                <h4 class="card-title mb-3">Authorization Error</h4>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
                <p class="text-muted small">
                    If you believe this is a mistake, please contact the application administrator.
                </p>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="close-window-btn">Close this window</button>
            </div>
        </div>
    </div>
    <script>
        document.getElementById('close-window-btn').addEventListener('click', function() {
            window.close();
        });
    </script>
</body>
</html>
