<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authorization Error</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YcnS/1Ysyl1FMJI55Rl0oIoU6SY22lFbOj0" crossorigin="anonymous">
    <style>
        body { background-color: #f8f9fa; }
        .auth-card {
            max-width: 440px;
            margin: 60px auto;
            border-top: 4px solid <%= tenantColor %>;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card auth-card shadow-sm">
            <div class="card-body p-4 text-center">
                <h4 class="card-title mb-3">Authorization Error</h4>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
                <p class="text-muted small">
                    If you believe this is a mistake, please contact the application administrator.
                </p>
            </div>
        </div>
    </div>
</body>
</html>
